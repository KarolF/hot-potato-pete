{
  "name": "hot-potato-pete",
  "version": "0.1.0",
  "main": "src/main.ts",
  "scripts": {
    "test": "vitest",
    "test:run": "vitest --run",
    "test:e2e": "playwright test",
    "dev": "webpack-dev-server --config webpack/config.dev.js",
    "build": "webpack --config webpack/config.prod.js",
    "build:poki": "webpack --config webpack/config.poki.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "check:assets": "node scripts/check-assets.mjs",
    "check:production": "node scripts/check-production.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test:run && npm run check:assets && npm run build && npm run build:poki && npm run check:production"
  },
  "author": "Karol Furmann",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@poki/phaser-3": "^0.0.6",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.14.0",
    "html-webpack-plugin": "^5.6.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^6.1.0"
  },
  "dependencies": {
    "phaser": "^3.80.1"
  },
  "private": true,
  "license": "UNLICENSED",
  "description": "A Phaser and TypeScript card game portfolio by Karol Furmann.",
  "engines": {
    "node": "^22.19.0 || ^24.0.0"
  }
}
