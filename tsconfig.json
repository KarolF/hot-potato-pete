{
  "compilerOptions": {
    "target": "ES2017",
    "allowSyntheticDefaultImports": true,
    "module": "ESNext",
    "outDir": "./dist/",
    "lib": [
      "ES2017",
      "DOM"
    ],
    "skipLibCheck": true,
    "downlevelIteration": true,
    "strictPropertyInitialization": true,
    "moduleResolution": "node",
    "noImplicitAny": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts"
  ]
}
